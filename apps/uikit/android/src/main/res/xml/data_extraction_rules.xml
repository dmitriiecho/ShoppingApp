<?xml version="1.0" encoding="utf-8"?>
<!--
    The UI kit keeps nothing worth saving, so nothing is copied. Android 12+ ignores allowBackup="false"
    for transfer to a new device; these rules turn off both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
