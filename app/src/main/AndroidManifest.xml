<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".ShoppingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShoppingApp">
        <!--
            When the theme is changed (in the system or in the application settings), the activity is not recreated:
            Compose simply redraws in new colors. Otherwise the screen would flicker each time the theme is changed.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!--
                    The same domain is specified in DeepLinkConfig.BASE_URL in core/config.
                    Update both places if it changes.
                -->
                <data
                    android:scheme="https"
                    android:host="dmitriiecho.github.io" />

                <!-- Only addresses that the application can open. -->
                <data android:path="/catalog" />
                <data android:path="/catalog/" />
                <data android:path="/cart" />
                <data android:path="/cart/" />
                <data android:pathPattern="/product/..*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
