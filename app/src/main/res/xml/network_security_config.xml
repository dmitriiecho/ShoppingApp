<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- У нашего сервера нет HTTPS (нет домена), поэтому обычный HTTP разрешён только для его адреса.
         Адрес тот же, что baseUrl в ConfigModule (core/config): при смене поменяйте его в обоих местах. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">2.56.204.151</domain>
    </domain-config>
</network-security-config>
